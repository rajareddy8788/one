@Library('devops-shared-library') _
pipeline {
    agent any
    tools {
      maven 'mymaven'
    }
    stages{
        stage('Checkout code') {
            steps{
                script{
                    checkoutCode()
                }
            }
        }
        stage('Build') {
            steps{
                script{
                    buildCode()
                }
            }
        }
        stage('Docker Build') {
            steps{
                script{
                    Dockerimage('raja8788/shared-library',"${env.BUILD_NUMBER}")
                }
            }
        }
    }
}
